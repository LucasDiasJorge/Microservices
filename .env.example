# Copie para .env e ajuste se quiser sobrescrever os defaults do docker-compose.
# Sem .env a stack sobe normalmente com os valores de desenvolvimento.

POSTGRES_PASSWORD=keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Deve bater com o secret de "my-client" em docker/keycloak/realm-import.json.
KEYCLOAK_CLIENT_SECRET=dev-local-secret-not-for-production
